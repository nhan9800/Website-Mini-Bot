# Chỉ đặt giá trị thật trên máy chủ hoặc .env.local; không commit thông tin bí mật.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXTAUTH_URL=https://mimibot.id.vn
NEXTAUTH_SECRET=

# Token web gọi bot, phải khớp MIMI_API_TOKEN của bot.
MIMI_API_BASE=
MIMI_API_TOKEN=

# Khoá riêng cho bảng duyệt Admin; không có khoá thì chức năng này bị vô hiệu hóa.
ADMIN_SECRET=

# Tuỳ chọn: đường dẫn tuyệt đối đến kho đánh giá ngoài thư mục build/deploy.
# Nếu bỏ trống dùng data/mimi_feedback_store.json; bảo toàn thư mục này khi deploy.
MIMI_FEEDBACK_STORE=
